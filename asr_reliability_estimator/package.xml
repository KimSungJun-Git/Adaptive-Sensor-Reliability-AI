<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>asr_reliability_estimator</name>
  <version>0.1.0</version>
  <description>Reliability AI: online feature building, ONNX inference,
    asymmetric smoothing, Adaptive EKF and the robot_localization
    covariance injector.</description>
  <maintainer email="ksj100848@gmail.com">Kim</maintainer>
  <license>Apache-2.0</license>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>asr_core</exec_depend>
  <exec_depend>asr_msgs</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <!-- onnxruntime is pip-installed; no rosdep key on Humble -->
  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
