# Lightweight runtime image for real-robot deployment:
# ROS2 + robot_localization + CPU ONNX Runtime. No Gazebo, no PyTorch.
ARG ROS_DISTRO=humble
FROM ros:${ROS_DISTRO}-ros-base

RUN apt-get update && apt-get install -y --no-install-recommends \
        ros-${ROS_DISTRO}-robot-localization \
        python3-pip python3-numpy python3-scipy \
    && rm -rf /var/lib/apt/lists/*
# Jazzy's base (Ubuntu 24.04) enforces PEP 668 (externally-managed-environment)
# and refuses a plain pip install; Humble's (22.04) doesn't understand
# --break-system-packages. Try the plain form first, fall back for Jazzy.
RUN pip3 install --no-cache-dir onnxruntime \
    || pip3 install --break-system-packages --no-cache-dir onnxruntime

WORKDIR /ws/src/adaptive_sensor_reliability
COPY asr_core asr_core
COPY asr_msgs asr_msgs
COPY asr_sensing asr_sensing
COPY asr_shadow_ekf asr_shadow_ekf
COPY asr_reliability_estimator asr_reliability_estimator
COPY asr_bringup asr_bringup

WORKDIR /ws
RUN . /opt/ros/${ROS_DISTRO}/setup.sh && colcon build

RUN echo 'source /ws/install/setup.bash' >> /root/.bashrc
CMD ["bash"]
